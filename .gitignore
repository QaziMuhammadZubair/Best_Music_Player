# Learn more: https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build folders (generated by `expo prebuild` / `expo run:*`)
/android
/ios

# Metro bundler
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log

# Signing keys & certificates (never commit these)
*.jks
*.p8
*.p12
*.key
*.keystore
!debug.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Environment variables
.env*.local

# Merge / patch leftovers
*.orig.*

# Testing
coverage/

# TypeScript
*.tsbuildinfo

# Editors / IDEs
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini
config.bat
